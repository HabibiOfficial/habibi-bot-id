# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env ke git.
# cp .env.example .env

# Port server API (default 3000)
PORT=3000

# Kunci akses API — WAJIB diisi dengan string acak yang panjang & aman.
# Dikirim client via header: x-api-key: <nilai-ini>
API_KEY=isi-dengan-key-aman

# Provider AI untuk POST /api/ai (boleh dikosongkan → endpoint menjawab 503).
# Contoh mode tanpa key (Pollinations, gratis): AI_API_URL=https://text.pollinations.ai
# Contoh mode OpenAI-compatible: AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_API_URL=

# Path binary yt-dlp di sistem (untuk /api/download/ytmp3 & /api/download/ytmp4)
YT_DLP_BIN=yt-dlp
