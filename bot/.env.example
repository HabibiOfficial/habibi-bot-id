# Contoh konfigurasi Habibi Bot ID — salin menjadi .env lalu isi nilainya.
# JANGAN commit file .env asli yang berisi data sensitif.

# Nama bot yang tampil di pesan
BOT_NAME=Habibi Bot ID

# Nomor WhatsApp owner (format internasional tanpa +, tanpa spasi)
OWNER_NUMBER=6285181576338

# Nama developer/pembuat
DEVELOPER=Habibih Cloud ID

# Prefix perintah
PREFIX=.

# Nomor WhatsApp BOT untuk pairing code (format: 628xxx, tanpa +).
# WAJIB diisi bila PAIR_METHOD=pairing. Ini nomor HP yang akan ditautkan sebagai bot.
BOT_NUMBER=628xxx

# Metode autentikasi: "pairing" (kode 8 digit) atau "qr" (QR di terminal)
PAIR_METHOD=pairing

# Level log aplikasi: debug|info|warn|error (opsional)
# LOG_LEVEL=info

# Level log internal Baileys (opsional): silent|warn|info|debug
# BAILEYS_LOG_LEVEL=warn
